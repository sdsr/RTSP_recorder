  "merge_notes": [
    "Retained prior live/profile/ping fixes instead of reverting to their original v5 copies.",
    "Three-way merged UI controller to preserve settings cache lock and closing guard.",
    "Retained legacy filename host ambiguity guard."
  ],
  "network_devices_modified_during_update": false,
  "first_run_policy": "New JSON configurations contain no camera/IP/account or geographic selection; existing runtime settings are preserved.",
  "configuration_policy": "Unlike the supplied standalone updater, integration preserves existing recording.json bytes. New installations default to window; legacy split settings remain until the operator changes mode.",
  "integration_fixes": [
    "Preserve v2.3 lifecycle/cache/privacy fixes",
    "Blank first-run camera/account/region with explicit registration",
    "Block unconfigured recording and forecast access",
    "Keep PNG on metadata-write failure and reject unsupported OS operations",
    "Validate malformed switch config/requests and tolerate socket-close race"
  ],
